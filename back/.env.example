DATABASE_URL=postgresql://policlinica:YOUR_PASSWORD@localhost:5432/policlinica
API_HOST=0.0.0.0
API_PORT=8000
# Нужен только если фронтенд ходит на API напрямую (VITE_API_URL задан).
# По умолчанию Vite-proxy / reverse proxy делают запросы same-origin.
CORS_ORIGINS=http://localhost:5173
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
DEFAULT_DISCOUNT_THRESHOLD_PERCENT=10
